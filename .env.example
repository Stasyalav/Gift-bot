# --- ВКонтакте ---
# Ключ доступа сообщества: Управление -> Работа с API -> Ключи доступа.
# Нужны права "Сообщения" и "Фотографии".
VK_TOKEN=
# Числовой ID сообщества (только цифры).
VK_GROUP_ID=

# --- GigaChat ---
# Ключ авторизации из личного кабинета developers.sber.ru (одна строка).
GIGACHAT_CREDENTIALS=
# Область доступа: для физического лица — GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat-2 / GigaChat-2-Pro / GigaChat-2-Max.
GIGACHAT_MODEL=GigaChat-2
# Путь к корневому сертификату Минцифры (от корня проекта).
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca.cer
# Таймаут одного запроса к GigaChat, секунды.
GIGACHAT_TIMEOUT_SECONDS=60
# Сколько раз повторять запрос при временных ошибках сети и API.
GIGACHAT_MAX_RETRIES=2

# --- Прочее ---
LOG_LEVEL=INFO
# Необязательный верхний предел бюджета подарка, ₽.
MAX_BUDGET_RUB=
